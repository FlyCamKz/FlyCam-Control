FLYCAM_API_KEY=
FLYCAM_ADMIN_KEY=replace-with-a-long-random-admin-key
FLYCAM_INGEST_KEY=replace-with-a-long-random-ingest-key
FLYCAM_VIEWER_KEY=replace-with-a-different-long-random-viewer-key
FLYCAM_OPERATOR_KEY=replace-with-a-third-long-random-operator-key
FLYCAM_RETENTION_DAYS=30
